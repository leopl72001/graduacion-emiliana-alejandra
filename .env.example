# Configura la MISMA instancia de Supabase que usa GradoPro, o una instancia nueva.
# Ejecuta primero supabase/schema.sql. Las tablas de este proyecto están aisladas.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE
# Alternativamente (claves legacy, desaconsejadas a largo plazo):
# VITE_SUPABASE_ANON_KEY=tu_clave_anon